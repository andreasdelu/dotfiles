#!/usr/bin/env bash

set -euo pipefail

kind="${1:?missing popup kind}"
client="${2:?missing client}"
pane="${3:?missing pane}"

client_tty="$(tmux list-clients -F '#{client_name}|#{client_tty}' | awk -F '|' -v client="$client" '$1 == client { print $2; exit }')"
[[ -n "$client_tty" ]] || exit 1

if [[ "$(tmux show-option -gqv @dotfiles-pane-dimming)" == on ]]; then
  "$HOME/.tmux/bin/emit-pane-metadata" --clear-client "$client_tty"
  trap '"$HOME/.tmux/bin/emit-pane-metadata"' EXIT
fi

case "$kind" in
  sessions)
    command -v fzf >/dev/null 2>&1 || exec tmux choose-session
    # Cancellation is a no-op. Pass a stable session ID, not a name through
    # xargs, and switch the client that opened this popup on its own server.
    # shellcheck disable=SC2016 # Variables expand inside the popup's shell.
    tmux display-popup -c "$client" -t "$pane" -E \
      -e "DOTFILES_TMUX_CLIENT=$client" \
      -e "DOTFILES_TMUX_SOCKET=$(tmux display-message -p '#{socket_path}')" '
        selection=$(tmux -S "$DOTFILES_TMUX_SOCKET" list-sessions -F "#{session_id} #{session_name}" |
          fzf --reverse --with-nth=2..) || exit 0
        [ -n "$selection" ] || exit 0
        tmux -S "$DOTFILES_TMUX_SOCKET" switch-client -c "$DOTFILES_TMUX_CLIENT" -t "${selection%% *}"
      '
    ;;
  worktrees)
    [[ -x "$HOME/.tmux/plugins/tmux-worktree-manager/dist/twm" ]] || exit 0
    tmux display-popup -c "$client" -t "$pane" -E -h '80%' -w '80%' \
      ~/.tmux/plugins/tmux-worktree-manager/scripts/run.sh
    ;;
  lazygit)
    command -v lazygit >/dev/null 2>&1 || exit 0
    current_path="$(tmux display-message -p -t "$pane" '#{pane_current_path}')"
    tmux display-popup -c "$client" -t "$pane" -E -w '90%' -h '90%' \
      -b rounded -d "$current_path" lazygit
    ;;
  *)
    printf 'Unknown popup kind: %s\n' "$kind" >&2
    exit 1
    ;;
esac
