theme = adwaita dark
font-size = 11.5
font-feature = -calt, -liga, -dlig
alpha-blending = native
window-colorspace = display-p3
window-width = 120
window-height = 30
macos-titlebar-style = tabs
palette-generate = false

shell-integration = zsh
mouse-hide-while-typing = true
scrollback-limit = 4294967295


keybind = super+h=goto_split:left
keybind = super+j=goto_split:bottom
keybind = super+k=goto_split:top
keybind = super+l=goto_split:right

keybind = super+shift+h=new_split:left
keybind = super+shift+j=new_split:down
keybind = super+shift+k=new_split:up
keybind = super+shift+l=new_split:right

window-save-state = always

keybind = super+shift+p=toggle_command_palette

custom-shader = /Users/andreasdeleuran/.config/ghostty/shaders/shader.glsl
